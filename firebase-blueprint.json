{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with multi-factor verification state",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email address" },
        "photoURL": { "type": "string", "description": "Profile avatar URL" },
        "phoneNumber": { "type": "string", "description": "Verified phone number" },
        "phoneVerified": { "type": "boolean", "description": "Whether SMS OTP verification is completed" },
        "authProviders": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of verified auth providers (google.com, microsoft.com, phone)"
        },
        "role": { "type": "string", "enum": ["customer", "worker", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "phoneVerified", "role", "createdAt"]
    },
    "Worker": {
      "title": "Worker",
      "description": "Verified plumber, painter, electrician, carpenter, HVAC, or masonry trade professional with transparent pricing and detailed credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "trade": {
          "type": "string",
          "enum": ["Plumber", "Painter", "Electrician", "Carpenter", "HVAC", "Masonry"]
        },
        "specialty": { "type": "string" },
        "avatar": { "type": "string" },
        "hourlyRate": { "type": "number" },
        "minCalloutFee": { "type": "number" },
        "materialsMarkupPct": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "completedJobs": { "type": "number" },
        "licenseNumber": { "type": "string" },
        "backgroundCheckId": { "type": "string" },
        "insuranceBondAmount": { "type": "number" },
        "verifiedPhone": { "type": "boolean" },
        "verifiedIdentity": { "type": "boolean" },
        "verifiedLicense": { "type": "boolean" },
        "yearsExperience": { "type": "number" },
        "neighborhood": { "type": "string" },
        "responseTimeMins": { "type": "number" },
        "bio": { "type": "string" },
        "warrantyMonths": { "type": "number" },
        "availabilityStatus": { "type": "string" },
        "serviceRadiusMiles": { "type": "number" },
        "onTimeRatePct": { "type": "number" },
        "repeatClientPct": { "type": "number" },
        "certifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "equipmentManifest": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transparentRates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task": { "type": "string" },
              "flatPrice": { "type": "number" },
              "estimatedHours": { "type": "string" }
            }
          }
        },
        "recentProjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "neighborhood": { "type": "string" },
              "duration": { "type": "string" },
              "finalCost": { "type": "number" },
              "materialsCost": { "type": "number" },
              "summary": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "name", "trade", "hourlyRate", "licenseNumber", "rating", "reviewCount"]
    },
    "Job": {
      "title": "Job",
      "description": "Real-time tracked service booking between customer and worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "workerTrade": { "type": "string" },
        "workerLicense": { "type": "string" },
        "title": { "type": "string" },
        "scopeDescription": { "type": "string" },
        "address": { "type": "string" },
        "scheduledFor": { "type": "string" },
        "estimatedHours": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "laborCost": { "type": "number" },
        "materialsAllowance": { "type": "number" },
        "escrowFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": {
          "type": "string",
          "enum": [
            "ESCROW_LOCKED",
            "WORKER_DISPATCHED",
            "ON_SITE_VERIFIED",
            "WORK_IN_PROGRESS",
            "COMPLETED_RELEASED"
          ]
        },
        "siteSafetyPin": { "type": "string" },
        "reviewed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "label": { "type": "string" },
              "timestamp": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "customerId", "workerId", "title", "totalAmount", "status", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Transparent escrow and payment ledger entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "customerId": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "workerTrade": { "type": "string" },
        "jobTitle": { "type": "string" },
        "laborCost": { "type": "number" },
        "materialsAllowance": { "type": "number" },
        "escrowFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["ESCROW_LOCKED", "RELEASED_TO_WORKER", "REFUNDED"] },
        "paymentMethod": { "type": "string" },
        "txHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "releasedAt": { "type": "string" }
      },
      "required": ["id", "jobId", "customerId", "workerId", "totalAmount", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer rating and review for a service provider",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "jobId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "transparencyScore": { "type": "number" },
        "craftsmanshipScore": { "type": "number" },
        "punctualityScore": { "type": "number" },
        "comment": { "type": "string" },
        "projectTitle": { "type": "string" },
        "verifiedHire": { "type": "boolean" },
        "finalCostPaid": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "workerId", "customerId", "rating", "comment", "createdAt"]
    },
    "EncryptedMessage": {
      "title": "EncryptedMessage",
      "description": "End-to-end AES-256-GCM encrypted chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "jobId": { "type": "string" },
        "workerId": { "type": "string" },
        "customerId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["customer", "worker", "system"] },
        "ciphertext": { "type": "string" },
        "iv": { "type": "string" },
        "keyFingerprint": { "type": "string" },
        "messageType": { "type": "string", "enum": ["text", "quote_lock", "pin_handshake"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "threadId", "senderId", "ciphertext", "iv", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication and verification records"
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Public directory of verified service providers"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Real-time tracked service jobs"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Escrow payment ledger entries"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified ratings and reviews for workers"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/EncryptedMessage" },
      "description": "AES-256-GCM encrypted chat messages"
    }
  }
}
