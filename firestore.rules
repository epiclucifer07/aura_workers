rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && isValidString(request.resource.data.displayName, 120);
      allow delete: if false;
    }

    // ===============================================================
    // Workers Directory (Publicly readable, authenticated create/update for reviews & registration)
    // ===============================================================
    match /workers/{workerId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && isValidString(request.resource.data.name, 120)
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 10
        && request.resource.data.hourlyRate <= 500;
      allow delete: if false;
    }

    // ===============================================================
    // Jobs Collection (Real-Time Job Status Tracking)
    // ===============================================================
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0;
      allow update: if isAuthenticated()
        && (resource.data.customerId == request.auth.uid || isAuthenticated());
      allow delete: if false;
    }

    // ===============================================================
    // Payments Collection (Escrow & Payment History)
    // ===============================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.totalAmount is number;
      allow update: if isAuthenticated()
        && resource.data.customerId == request.auth.uid;
      allow delete: if false;
    }

    // ===============================================================
    // Reviews Collection (Ratings & Reviews for Service Providers)
    // ===============================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isValidString(request.resource.data.comment, 2000);
      allow update, delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }

    // ===============================================================
    // Encrypted Messages Collection (AES-256-GCM Chat)
    // ===============================================================
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isValidString(request.resource.data.ciphertext, 8000)
        && isValidString(request.resource.data.iv, 256);
      allow update, delete: if false;
    }
  }
}
